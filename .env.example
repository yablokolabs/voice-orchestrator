# Voice Orchestrator environment configuration
# Copy to .env and fill in your values

VO_ENVIRONMENT=development
VO_DEBUG=true

# Database
VO_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_orchestrator

# Redis
VO_REDIS_URL=redis://localhost:6379/0
VO_CELERY_BROKER_URL=redis://localhost:6379/1
VO_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# STT Providers
VO_DEFAULT_STT_PROVIDER=whisper
VO_WHISPER_API_KEY=
VO_DEEPGRAM_API_KEY=
VO_ASSEMBLYAI_API_KEY=

# LLM Providers
VO_DEFAULT_LLM_PROVIDER=openai
VO_OPENAI_API_KEY=
VO_ANTHROPIC_API_KEY=
VO_BEDROCK_REGION=us-east-1

# Observability
VO_OTEL_ENDPOINT=http://localhost:4317

# LangSmith
VO_LANGSMITH_API_KEY=
VO_LANGSMITH_PROJECT=voice-orchestrator
